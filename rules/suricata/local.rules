alert tcp any any -> $HOME_NET 22 (msg:"Possible SSH Brute Force Attempt"; flow:established,to_server; content:"SSH-"; offset:0; depth:4; detection_filter:track by_src, count 5, seconds 300; classtype:attempted-admin; priority:2; sid:2005; rev:2;)
alert http any any -> any any (msg:"[TEST] EICAR in ELF"; flow:established,to_client; filemagic:"ELF"; classtype:trojan-activity; sid:1000020; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET ![21,22,23,25,80,443] (msg:"EXFILTRATION Netcat Data Transfer (Large Volume)"; flow:established,to_server; content:">"; sid:100001;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"EXFILTRATION Potential Netcat Reverse Shell"; flow:established,to_server; content:"nc"; nocase; pcre:"/nc\s+/"; sid:100003;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 22 (msg:"EXFILTRATION Large File Transfer via SCP"; flow:established,to_server; content:"scp"; nocase; content:!"-i"; sid:100005;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 22 (msg:"EXFILTRATION Multiple SCP Transfers"; flow:established,to_server; content:"scp"; nocase; pcre:"/scp\s+(?:-[a-z]+\s+)*\S+/"; sid:100007;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"EXFILTRATION Python HTTP Server on Non-Standard Port"; flow:established,to_server; content:"python"; nocase; sid:100009;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"EXFILTRATION Data Compression Using gzip"; flow:established,to_server; content:"gzip"; nocase; content:!"--decompress"; sid:100011;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"EXFILTRATION Sensitive Data Compression Using zip"; flow:established,to_server; content:"zip"; nocase; pcre:"/zip\s+(?!-d)/"; sid:100013;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 873 (msg:"EXFILTRATION Large Data Transfer via rsync"; flow:established,to_server; content:"rsync"; nocase; pcre:"/rsync\s+/"; sid:100015;)
alert udp $HOME_NET any -> $EXTERNAL_NET 53 (msg:"EXFILTRATION DNS Tunneling Detection"; flow:established,to_server; content:"|01 00 00 01 00 00 00 00 00 00|"; sid:100017;)
alert tcp $HOME_NET any -> $EXTERNAL_NET ![22,80,443] (msg:"EXFILTRATION ARM64 Outbound to Unusual Port"; flow:established,to_server; byte_test:6,>,1048576,0; sid:100018;)
