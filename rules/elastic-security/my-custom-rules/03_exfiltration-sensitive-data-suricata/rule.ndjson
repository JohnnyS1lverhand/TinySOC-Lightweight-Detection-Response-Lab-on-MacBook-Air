{"id":"421f19e6-ae18-43da-bc73-36776ad658ec","updated_at":"2025-05-16T16:19:42.239Z","updated_by":"elastic","created_at":"2025-05-11T15:58:47.945Z","created_by":"elastic","name":"Exfiltration of Sensitive Data (Suricata)","tags":["Domain: Network","Use Case: Threat Detection","Tactic: Exfiltration","Data Source: Suricata","Type: Custom"],"interval":"5m","enabled":false,"revision":3,"description":"Detects potential data exfiltration activity based on Suricata alerts that contain the keyword \"EXFILTRATION\" in either the event message or signature fields. This rule helps identify suspicious outbound network activity that may indicate an attempt to transfer sensitive data outside the organization. Alert suppression is configured to group alerts by signature per rule execution, minimizing alert fatigue from repeated or duplicate detections.","risk_score":73,"severity":"high","note":"- Review the source and destination IP addresses involved in the alert.\n- Investigate the context of the Suricata signature that triggered the detection.\n- Determine if the activity is expected or authorized (e.g., legitimate backup or data transfer).\n- If the activity is unauthorized, follow your incident response procedures to contain and analyze the event.","license":"","output_index":"","meta":{"kibana_siem_app_url":"http://192.168.1.36:5601/app/security"},"author":[],"false_positives":[],"from":"now-14m","rule_id":"bd36e4f0-b90e-4223-bdaa-1a62bb93ca6c","max_signals":30,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0010","name":"Exfiltration","reference":"https://attack.mitre.org/tactics/TA0010/"},"technique":[{"id":"T1048","name":"Exfiltration Over Alternative Protocol","reference":"https://attack.mitre.org/techniques/T1048/","subtechnique":[]},{"id":"T1030","name":"Data Transfer Size Limits","reference":"https://attack.mitre.org/techniques/T1030/","subtechnique":[]},{"id":"T1041","name":"Exfiltration Over C2 Channel","reference":"https://attack.mitre.org/techniques/T1041/","subtechnique":[]},{"id":"T1567","name":"Exfiltration Over Web Service","reference":"https://attack.mitre.org/techniques/T1567/","subtechnique":[]}]}],"to":"now","references":["https://www.elastic.co/security-labs/data-exfiltration"],"version":2,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","data_view_id":"b297c3e1-e8a0-47b0-941d-08e89fd28cd5","query":"event.module:\"suricata\"\nAND suricata.eve.event_type:\"alert\"\nAND suricata.eve.alert.signature: *EXFILTRATION*","filters":[],"alert_suppression":{"group_by":["suricata.eve.alert.signature"],"missing_fields_strategy":"suppress"},"actions":[{"id":"4ca36ef9-aa9a-4d73-8f12-ba8e2f7c8228","params":{"body":"{\n  \"chat_id\": \"<your_chatid>\",\n  \"text\": \"{{rule.name}} Detected!\\n\\n{{context.rule.description}}\\n\\nRule type: {{context.rule.type}}\\nSeverity: {{context.rule.severity}}\\nRisk score: {{context.rule.risk_score}}\\nReferences: {{context.rule.references}}\\nTags: {{rule.tags}}\"\n}\n"},"action_type_id":".webhook","uuid":"21c56643-3785-49a6-b116-2f747a4b690c","frequency":{"summary":true,"notifyWhen":"onActiveAlert","throttle":null},"group":"default"}]}
