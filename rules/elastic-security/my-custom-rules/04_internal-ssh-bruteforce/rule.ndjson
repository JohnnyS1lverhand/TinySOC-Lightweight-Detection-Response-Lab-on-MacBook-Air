{"id":"0a3ba18e-0adf-420f-8f54-ef71d54be0db","updated_at":"2025-05-11T16:03:49.192Z","updated_by":"elastic","created_at":"2025-04-29T12:53:16.088Z","created_by":"elastic","name":"Potential Internal Linux SSH Brute Force","tags":["Domain: Endpoint","OS: Linux","Use Case: Threat Detection","Tactic: Credential Access","Data Source: Auditd","Type: Custom"],"interval":"5m","enabled":true,"revision":12,"description":"Detects multiple consecutive SSH login failures originating from an internal source IP targeting the same user account on a Linux host, followed by a successful login within a short time window. This pattern may indicate a brute-force attempt where an adversary eventually gained access using valid credentials.","risk_score":47,"severity":"medium","note":"- Investigate the login failure user name(s).\n- Investigate the source IP address of the failed ssh login attempt(s).\n- Investigate other alerts associated with the user/host during the past 48 hours.\n- Identify the source and the target computer and their roles in the IT environment.","license":"","output_index":"","meta":{"kibana_siem_app_url":"http://192.168.1.36:5601/app/security"},"author":[],"false_positives":["Authentication misconfiguration or obsolete credentials.","Service account password expired.","Infrastructure or availability issue."],"from":"now-14m","rule_id":"0087db7c-814f-4edf-a996-8b197586bbb8","max_signals":1,"risk_score_mapping":[],"severity_mapping":[],"threat":[],"to":"now","references":[],"version":3,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"eql","language":"eql","data_view_id":"logs-*","query":"sequence by host.id, source.ip, user.name with maxspan=5m\n  [ authentication\n    where host.os.type == \"linux\"\n      and auditd.log.record_type == \"USER_AUTH\"\n      and event.outcome == \"failure\"\n      and cidrmatch(source.ip,\n        \"10.0.0.0/8\", \"127.0.0.0/8\", \"169.254.0.0/16\", \"172.16.0.0/12\", \"192.0.0.0/24\",\n        \"192.0.0.0/29\", \"192.0.0.8/32\", \"192.0.0.9/32\", \"192.0.0.10/32\", \"192.0.0.170/32\", \"192.0.0.171/32\",\n        \"192.0.2.0/24\", \"192.31.196.0/24\", \"192.52.193.0/24\", \"192.168.0.0/16\", \"192.88.99.0/24\", \"224.0.0.0/4\",\n        \"100.64.0.0/10\", \"192.175.48.0/24\", \"198.18.0.0/15\", \"198.51.100.0/24\", \"203.0.113.0/24\", \"240.0.0.0/4\",\n        \"::1\", \"FE80::/10\", \"FF00::/8\")\n  ] with runs = 5\n\n  [ authentication\n    where host.os.type == \"linux\"\n      and auditd.log.record_type == \"USER_AUTH\"\n      and event.outcome == \"success\"\n  ]","filters":[],"actions":[{"id":"4ca36ef9-aa9a-4d73-8f12-ba8e2f7c8228","params":{"body":"{\n  \"chat_id\": \"<your_chat_id>\",\n  \"text\": \"{{rule.name}} Detected!\\n\\n{{context.rule.description}}\\n\\nRule type: {{context.rule.type}}\\nSeverity: {{context.rule.severity}}\\nRisk score: {{context.rule.risk_score}}\\nTags: {{rule.tags}}\"\n}"},"action_type_id":".webhook","uuid":"82a3d38c-d04e-41bc-bd5b-cd6b68c6f5a9","frequency":{"summary":true,"notifyWhen":"onActiveAlert","throttle":null},"group":"default"}]}
