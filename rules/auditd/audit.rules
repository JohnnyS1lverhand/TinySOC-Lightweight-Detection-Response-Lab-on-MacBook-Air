# Clear all previous audit rules and set buffer size
-D
-b 32768
-f 1
-i

# ===========================
# Audit configuration changes
# ===========================
-w /etc/audit/ -p wa -k auditconfig
-w /etc/audit/rules.d/ -p wa -k audit_rules
-w /usr/sbin/auditctl -p x -k audittools

# ===========================
# System binaries and tools
# ===========================
-w /bin/ -p x -k system_binaries
-w /usr/bin/ -p x -k user_binaries
-w /sbin/ -p x -k system_tools

# ===========================
# Security-related configuration files
# ===========================
-w /etc/passwd -p wa -k user_accounts
-w /etc/group -p wa -k group_changes
-w /etc/shadow -p wa -k shadow_changes
-w /etc/gshadow -p wa -k gshadow_changes
-w /etc/sudoers -p wa -k sudoers_changes
-w /etc/sudoers.d/ -p wa -k sudoers_d_changes
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/security/ -p wa -k security_config
-w /etc/pam.d/ -p wa -k pam_changes
-w /etc/login.defs -p wa -k login_defs

# ===========================
# User environment and login banners
# ===========================
-w /etc/profile -p wa -k profile_changes
-w /etc/bash.bashrc -p wa -k bashrc_changes
-w /root/.bashrc -p wa -k root_bashrc_change
-w /etc/issue -p wa -k issue_changes
-w /etc/motd -p wa -k motd_changes

# ===========================
# Crontab and scheduled tasks
# ===========================
-w /etc/crontab -p wa -k crontab_changes
-w /etc/cron.d -p wa -k cron_modification
-w /etc/cron.hourly/ -p wa -k cron_hourly
-w /etc/cron.daily/ -p wa -k cron_daily
-w /etc/cron.weekly/ -p wa -k cron_weekly
-w /etc/cron.monthly/ -p wa -k cron_monthly
-w /var/spool/cron/ -p wa -k user_crontabs

# ===========================
# System service configurations
# ===========================
-w /etc/systemd/ -p wa -k systemd_units
-w /etc/init.d/ -p wa -k init_scripts

# ===========================
# Network and name service configuration
# ===========================
-w /etc/hosts -p wa -k network_mod
-w /etc/nsswitch.conf -p wa -k name_service
-w /etc/resolv.conf -p wa -k dns_changes
-w /etc/sysctl.conf -p wa -k sysctl_conf
-w /etc/sysctl.d/ -p wa -k sysctl_d

# ===========================
# Kernel module operations
# ===========================
-w /sbin/insmod -p x -k kernel_modules
-w /sbin/rmmod -p x -k module_removal
-w /sbin/modprobe -p x -k modprobe_exec

# ===========================
# Log files monitoring
# ===========================
-w /var/log/ -p wa -k log_changes
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock/ -p wa -k failed_logins
-w /var/log/sudo.log -p wa -k sudo_log

# ===========================
# Privilege escalation and process execution
# ===========================
-a always,exit -F arch=b64 -S execve,execveat -F key=process_execution
-a always,exit -F arch=b64 -S clone,clone3 -F key=process_creation
-a always,exit -F arch=b64 -S setgid,setuid -F auid>=1000 -F key=priv_esc
-a always,exit -F arch=b64 -S fchmod,fchmodat -F auid>=1000 -F key=file_perms

# ===========================
# File access errors (ARM64-safe syscalls only)
# ===========================
-a always,exit -F arch=b64 -S openat,openat2,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=4294967295 -F key=file_access_err
-a always,exit -F arch=b64 -S openat,openat2,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=4294967295 -F key=file_perm_err

# ===========================
# File deletion and renaming (ARM64-safe syscalls only)
# ===========================
-a always,exit -F arch=b64 -S unlinkat -F auid>=1000 -F auid!=4294967295 -F key=file_deletion
-a always,exit -F arch=b64 -S renameat,renameat2 -F auid>=1000 -F auid!=4294967295 -F key=file_rename

# ===========================
# Mount and unmount operations
# ===========================
-a always,exit -F arch=b64 -S umount2,mount -F key=mount_operations

# ===========================
# Time changes
# ===========================
-a always,exit -F arch=b64 -S clock_settime,settimeofday,adjtimex -F key=time_change

# ===========================
# Network activity
# ===========================
-a always,exit -F arch=b64 -S bind,listen,accept,connect -F key=network_activity

# ===========================
# su and sudo usage
# ===========================
-w /bin/su -p x -k su_attempt
-w /usr/bin/sudo -p x -k sudo_attempt
-w /usr/bin/sudoedit -p x -k sudoedit_attempt

# ===========================
# Optional: Monitor user home directories (uncomment if needed)
# ===========================
# -w /home/ -p wa -k home_changes
